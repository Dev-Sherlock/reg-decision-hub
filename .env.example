# ---- Host ports ----
# Only needed when the defaults collide with something already on your machine.
# 8000 is a common casualty; move the API and tell the UI where it went.
# Check what holds a port first:  docker ps --filter publish=8000
# API_HOST_PORT=8010
# VITE_API_URL=http://localhost:8010
# Where the eval/ scripts look for the API and the LLM service.
# EVAL_API_BASE=http://localhost:8010
# EVAL_LLM_BASE=http://localhost:8001

# ---- LLM Service (llm container) ----
# Path to a .gguf file inside the ./models volume. Must match the filename
# produced by scripts/download_model.sh (or scripts/download_model.ps1).
#   scripts/download_model.sh tiny           -> SmolLM2-135M-Instruct-Q4_K_M.gguf (105MB, default)
#   scripts/download_model.sh tinyllama-1.1b -> tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf (638MiB)
MODEL_PATH=/models/SmolLM2-135M-Instruct-Q4_K_M.gguf
N_CTX=2048
N_GPU_LAYERS=0
# Discourages the completion loops small models fall into. 1.0 disables it.
REPEAT_PENALTY=1.15

# ---- API ----
# How the API reaches the LLM. "http" proxies to the llm container,
# "openrouter" uses the OpenRouter API directly.
LLM_PROVIDER=http
LLM_SERVICE_URL=http://llm:8001
LLM_SERVICE_TIMEOUT=120

# OpenRouter alternative (only used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-2-7b-chat:free

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector width of the configured embedding model. all-MiniLM-L6-v2 = 384.
# Changing this requires dropping/recreating symbolic_facts.embedding.
EMBEDDING_DIM=384

# ---- PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/regdecision

# ---- Knowledge base ----
# Path (inside the api container) of the symbolic memory Prolog module.
KB_PATH=/kb/symbolic_memory.pl
# Path (inside the api container) of the energy decision-tree example module.
DECISION_TREE_PATH=/kb/decision_tree.pl

# ---- API access control ----
# Single shared key. When unset, /memory/query (arbitrary Prolog) is disabled.
ADMIN_API_KEY=